{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "logs/sources_visited.json (sources_visited-1.0)",
  "type": "object",
  "required": ["schema","epochs","references","source_families","service_events","sequence_counter"],
  "properties": {
    "schema": {"const": "sources_visited-1.0"},
    "epochs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["epoch_id","scope_trigger","as_of","required_dimensions","discovery_procedure","status"]}},
    "references": {"type": "array", "items": {"type": "object", "required": ["ref_id","family","status","admission_seq","ticket_seq","projections"], "properties": {"status": {"enum": ["UNVISITED","IN_PROGRESS","RETRYABLE_FAILURE","VISITED","ACCESS_BOUNDARY","REPRESENTATION_DUPLICATE","NON_CONNECTED"]}}}},
    "service_events": {"type": "array", "items": {"type": "object", "required": ["event","at","seq","ref_id"]}}
  }
}
