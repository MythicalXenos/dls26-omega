    "def gp_spider():\n",
    "    conn = pymysql.connect(\n",
    "        host=\"\n",
    "        user=\"\",\n",
    "        password=\"\",\n",
    "        db=\"master_risk\",\n",
    "        charset=\"utf8\")\n",
    "    sql = f\"\"\"\n",
    "                SELECT\n",
    "                * from t_gp_spider where status != 404\n",
    "            \"\"\"\n",
    "\n",
    "    data = pd.read_sql(sql, conn)\n",
    "    conn.close()\n",
    "    return data"
   ]
