{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "logs/turn_manifest.json (turn_manifest-1.0)",
  "type": "object",
  "required": ["schema","protocol_version","session_id","turn_id","sequence","checkpoint_nonce","mode","step","phase","next_step","terminal_line_class","terminal_line","parent_commit","prompt_sha256","artifact_manifest","created_at"],
  "not": {"anyOf": [{"required": ["enclosing_commit"]}, {"required": ["own_commit"]}, {"required": ["checkpoint_commit"]}, {"required": ["commit_hash"]}]},
  "properties": {
    "parent_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "terminal_line_class": {"enum": ["BOOTSTRAP_START","CONTINUE","ATTENTION_REQUIRED","PUBLICATION_PENDING","PROTOCOL_ERROR","COMPLETE","RESEARCH_CONTINUE","RESEARCH_PAUSED","RESEARCH_COMPLETE"]},
    "artifact_manifest": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path","sha256","bytes"]}}
  }
}
